    rdfs:label "pantoprazole" ;
    ns1:administered_via <http://drugkg.example.org/entity/infusion_into_a_vein>,
        <http://drugkg.example.org/entity/oral> ;
    ns1:affects <http://drugkg.example.org/entity/vitamin_b_12_absorption> ;
    ns1:belongs_to_drug_class <http://drugkg.example.org/entity/proton_pump_inhibitor>,
        <http://drugkg.example.org/entity/proton_pump_inhibitors> ;
    ns1:contraindicated_in <http://drugkg.example.org/entity/allergy_to_lansoprazole>,
        <http://drugkg.example.org/entity/allergy_to_nexium>,
        <http://drugkg.example.org/entity/allergy_to_omeprazole>,
        <http://drugkg.example.org/entity/allergy_to_pantoprazole>,
        <http://drugkg.example.org/entity/allergy_to_prevacid>,
        <http://drugkg.example.org/entity/allergy_to_prilosec>,
        <http://drugkg.example.org/entity/history_of_breathing_problems>,
        <http://drugkg.example.org/entity/history_of_kidney_problems>,
        <http://drugkg.example.org/entity/history_of_severe_allergic_reaction> ;
    ns1:has_administration_instruction <http://drugkg.example.org/entity/40_mg_orally_once_a_day_for_short_term_administration_up_to_8_weeks>,
        <http://drugkg.example.org/entity/40_mg_orally_once_daily_until_day_28>,
        <http://drugkg.example.org/entity/40_mg_twice_daily_to_a_maximum_of_240_mg_per_day>,
        <http://drugkg.example.org/entity/80_mg_every_12_hours_administered_by_15_minute_infusion>,
        <http://drugkg.example.org/entity/additional_8_weeks_may_be_considered_for_patients_who_have_not_healed_after_the_initial_treatment>,
        <http://drugkg.example.org/entity/administered_by_15_minute_infusion>,
        <http://drugkg.example.org/entity/administered_for_more_than_6_days_have_not_been_studied>,
        <http://drugkg.example.org/entity/administered_in_equally_divided_doses_by_15_minute_infusion>,
        <http://drugkg.example.org/entity/administered_via_intravenous_infusion_over_15_minutes>,
        <http://drugkg.example.org/entity/as_a_bolus_infusion_over_a_period_of_15_minutes>,
        <http://drugkg.example.org/entity/ask_your_doctor_or_pharmacist_if_you_have_any_questions>,
        <http://drugkg.example.org/entity/be_aware_of_increased_risk_of_broken_bone_with_long_term_or_frequent_use>,
        <http://drugkg.example.org/entity/call_doctor_if_diarrhea_is_watery_or_has_blood_in_it>,
        <http://drugkg.example.org/entity/call_doctor_if_symptoms_do_not_improve_or_worsen>,
