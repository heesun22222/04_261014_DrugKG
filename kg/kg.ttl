<http://drugkg.example.org/entity/acetaminophen_overdose> a <http://drugkg.example.org/type/Condition> ;
    rdfs:label "acetaminophen overdose" ;
    ns1:has_symptom <http://drugkg.example.org/entity/confusion_or_weakness>,
        <http://drugkg.example.org/entity/dark_urine>,
        <http://drugkg.example.org/entity/loss_of_appetite>,
        <http://drugkg.example.org/entity/nausea>,
        <http://drugkg.example.org/entity/stomach_pain>,
        <http://drugkg.example.org/entity/sweating>,
        <http://drugkg.example.org/entity/upper_stomach_pain>,
        <http://drugkg.example.org/entity/vomiting>,
        <http://drugkg.example.org/entity/yellowing_of_skin_or_whites_of_eyes> .

<http://drugkg.example.org/entity/albuterol_inhalation> a <http://drugkg.example.org/type/Drug> ;
    rdfs:label "Albuterol Inhalation" ;
    ns1:belongs_to_drug_class <http://drugkg.example.org/entity/adrenergic_bronchodilators> ;
    ns1:contraindicated_in <http://drugkg.example.org/entity/allergy_to_albuterol>,
        <http://drugkg.example.org/entity/allergy_to_milk_proteins> ;
    ns1:has_administration_instruction <http://drugkg.example.org/entity/always_follow_your_doctor_s_directions_when_giving_albuterol_to_a_child>,
        <http://drugkg.example.org/entity/always_use_new_inhaler_device_provided_with_refill>,
        <http://drugkg.example.org/entity/ask_your_doctor_or_pharmacist_if_you_have_any_questions>,
        <http://drugkg.example.org/entity/call_your_doctor_for_medical_advice_about_side_effects>,
        <http://drugkg.example.org/entity/clean_the_plastic_actuator_with_the_canister_removed_at_least_once_a_week>,
        <http://drugkg.example.org/entity/do_not_allow_a_young_child_to_use_albuterol_inhalation_without_help_from_an_adult>,
        <http://drugkg.example.org/entity/do_not_change_your_doses_or_medication_schedule_without_your_doctor_s_advice>,
        <http://drugkg.example.org/entity/do_not_float_medicine_canister_in_water_to_check_if_empty>,
        <http://drugkg.example.org/entity/do_not_puncture_or_burn_an_empty_inhaler_canister>,
        <http://drugkg.example.org/entity/do_not_use_a_spacer_or_volume_holding_chamber_with_proair_respiclick>,
        <http://drugkg.example.org/entity/do_not_use_in_larger_or_smaller_amounts_or_for_longer_than_recommended>,
        <http://drugkg.example.org/entity/do_not_wash_or_put_any_part_of_the_proair_respiclick_inhaler_device_in_water>,
        <http://drugkg.example.org/entity/follow_all_directions_on_your_prescription_label>,
        <http://drugkg.example.org/entity/follow_all_medication_instructions_very_carefully>,
        <http://drugkg.example.org/entity/follow_product_instructions_on_how_to_clean_your_albuterol_inhaler_device_and_mouthpiece>,
        <http://drugkg.example.org/entity/get_prescription_refilled_before_running_out_of_medicine_completely>,
        <http://drugkg.example.org/entity/if_the_mouthpiece_needs_cleaning_gently_wipe_it_with_a_dry_cloth_or_tissue>,
        <http://drugkg.example.org/entity/keep_on_hand_at_all_times>,
        <http://drugkg.example.org/entity/keep_using_all_other_medications_as_prescribed_by_your_doctor>,
        <http://drugkg.example.org/entity/keeping_your_inhaler_clean_is_important_to_ensure_you_are_receiving_the_medication>,
        <http://drugkg.example.org/entity/may_also_need_to_shake_your_albuterol_device_just_before_each_use>,
        <http://drugkg.example.org/entity/may_need_to_prime_your_albuterol_inhaler_device_before_the_first_use>,
        <http://drugkg.example.org/entity/only_use_as_prescribed_by_your_physician>,
        <http://drugkg.example.org/entity/read_all_patient_information_medication_guides_and_instruction_sheets_provided>,
        <http://drugkg.example.org/entity/read_the_medication_guide_or_patient_instructions_provided_with_each_medication>,
        <http://drugkg.example.org/entity/replace_your_inhaler_if_it_is_washed_or_placed_in_water>,
        <http://drugkg.example.org/entity/rinse_with_water_if_gets_in_eyes>,
        <http://drugkg.example.org/entity/seek_medical_attention_if_asthma_medications_are_not_working_as_well>,
        <http://drugkg.example.org/entity/talk_with_your_doctor_if_asthma_medications_do_not_seem_to_work_as_well_in_treating_or_preventing_attacks>,
        <http://drugkg.example.org/entity/talk_with_your_doctor_if_increased_need_for_medication_in_24_hour_period>,
        <http://drugkg.example.org/entity/use_2_inhalations_15_to_30_minutes_before_exercise_to_prevent_exercise_induced_bronchospasm>,
        <http://drugkg.example.org/entity/use_all_medications_as_directed_by_your_doctor>,
        <http://drugkg.example.org/entity/use_dose_counter_on_inhaler_device>,
        <http://drugkg.example.org/entity/use_exactly_as_prescribed_by_your_doctor>,
