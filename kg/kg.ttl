<http://drugkg.example.org/entity/allopurinol> a <http://drugkg.example.org/type/Drug> ;
    rdfs:label "Allopurinol" ;
    ns1:belongs_to_drug_class <http://drugkg.example.org/entity/antigout_agents>,
        <http://drugkg.example.org/entity/antihyperuricemic_agents>,
        <http://drugkg.example.org/entity/xanthine_oxidase_inhibitors> ;
    ns1:contraindicated_in <http://drugkg.example.org/entity/allergic_reaction_to_allopurinol>,
        <http://drugkg.example.org/entity/allergy_to_allopurinol> ;
    ns1:does_not_need_to_be_stopped_during <http://drugkg.example.org/entity/acute_flare> ;
    ns1:has_administration_instruction <http://drugkg.example.org/entity/avoid_drinking_alcohol>,
        <http://drugkg.example.org/entity/avoid_driving_or_activities_requiring_alertness>,
        <http://drugkg.example.org/entity/call_your_doctor_for_medical_advice_about_side_effects>,
        <http://drugkg.example.org/entity/do_not_breastfeed_for_at_least_1_week_after_last_dose>,
        <http://drugkg.example.org/entity/do_not_breastfeed_while_using_this_medicine>,
        <http://drugkg.example.org/entity/doctor_may_change_dose_if_kidney_function_changes>,
        <http://drugkg.example.org/entity/doctor_may_recommend_another_gout_medication_to_take_with_allopurinol>,
        <http://drugkg.example.org/entity/drink_8_to_10_full_glasses_of_fluid_every_day>,
        <http://drugkg.example.org/entity/follow_a_special_diet_to_help_prevent_kidney_stones>,
        <http://drugkg.example.org/entity/follow_all_directions_on_your_prescription_label>,
        <http://drugkg.example.org/entity/follow_all_instructions_of_your_doctor_or_dietitian>,
        <http://drugkg.example.org/entity/impaired_reactions>,
        <http://drugkg.example.org/entity/keep_taking_the_medicine_as_directed>,
        <http://drugkg.example.org/entity/learn_about_the_foods_you_should_eat_or_avoid>,
        <http://drugkg.example.org/entity/read_all_medication_guides_or_instruction_sheets>,
        <http://drugkg.example.org/entity/report_side_effects_to_fda_at_1_800_fda_1088>,
