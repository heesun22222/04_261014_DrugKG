ns1:administered_via a rdf:Property ;
    rdfs:label "administered via" ;
    rdfs:comment "The subject drug is given through the route of administration specified by the object entity." .

ns1:affected_by a rdf:Property ;
    rdfs:label "affected by" ;
    rdfs:comment "The subject entity is influenced or altered by the factor specified by the object entity." .

ns1:affects a rdf:Property ;
    rdfs:label "affects" ;
    rdfs:comment "The subject drug may influence or impact the physiological or developmental process specified by the object entity." .

ns1:are_commonly_prescribed a rdf:Property ;
    rdfs:label "are commonly prescribed" ;
    rdfs:comment "The subject drug class is frequently prescribed among the categories specified by the object entity." .

ns1:average_starting_weight a rdf:Property ;
    rdfs:label "average starting weight" ;
    rdfs:comment "The subject treatment or group had patients with the average initial body weight specified by the object entity." .

ns1:belongs_to_drug_class a rdf:Property ;
    rdfs:label "belongs to drug class" ;
    rdfs:comment "The subject drug is a member of the pharmacological or therapeutic drug class specified by the object entity." .

ns1:binds_to a rdf:Property ;
    rdfs:label "binds to" ;
    rdfs:comment "The subject entity physically interacts with or attaches to the object entity." .

ns1:blocks a rdf:Property ;
    rdfs:label "blocks" ;
    rdfs:comment "The subject drug inhibits or prevents the function of the receptor or pathway specified by the object entity." .

ns1:can_be_used_with a rdf:Property ;
    rdfs:label "can be used with" ;
    rdfs:comment "The subject drug can be administered concurrently with the substance or medication specified by the object entity." .

ns1:can_mask a rdf:Property ;
    rdfs:label "can mask" ;
    rdfs:comment "The subject drug may conceal or obscure the symptoms or signs specified by the object entity." .

ns1:can_reactivate a rdf:Property ;
    rdfs:label "can reactivate" ;
    rdfs:comment "The subject drug may cause the dormant or previously resolved medical condition specified by the object entity to become active again." .

ns1:caused_birth_defects_in a rdf:Property ;
    rdfs:label "caused birth defects in" ;
    rdfs:comment "The subject drug caused the specified adverse developmental outcome in the object entity." .

ns1:compared_with a rdf:Property ;
    rdfs:label "compared with" ;
    rdfs:comment "The subject drug is compared to the object entity in clinical trials or studies." .

ns1:contains_ingredient a rdf:Property ;
    rdfs:label "contains ingredient" ;
    rdfs:comment "The subject drug product contains the active ingredient specified by the object entity." .

ns1:contraindicated_in a rdf:Property ;
    rdfs:label "contraindicated in" ;
    rdfs:comment "The subject drug should not be used by patients who have the condition or characteristic specified by the object entity." .

ns1:cost_condition a rdf:Property ;
    rdfs:label "cost condition" ;
    rdfs:comment "The subject drug's cost is subject to the condition specified by the object entity." .

ns1:crosses_placenta a rdf:Property ;
    rdfs:label "crosses placenta" ;
    rdfs:comment "The subject drug is able to pass through the placental barrier and reach the fetal circulation." .

ns1:did_not_demonstrate a rdf:Property ;
    rdfs:label "did not demonstrate" ;
    rdfs:comment "The subject study failed to show or prove the outcome or result specified by the object entity." .

ns1:distinguished_from a rdf:Property ;
    rdfs:label "distinguished from" ;
    rdfs:comment "The subject drug can be differentiated or identified as separate from the substance specified by the object entity." .

ns1:does_not_act_on a rdf:Property ;
    rdfs:label "does not act on" ;
    rdfs:comment "The subject drug does not exert its effects on the anatomical or physiological entity specified by the object entity." .

ns1:does_not_increase_risk_of a rdf:Property ;
    rdfs:label "does not increase risk of" ;
    rdfs:comment "The subject drug does not elevate the risk of the medical condition or event specified by the object entity." .

ns1:does_not_interact_with a rdf:Property ;
    rdfs:label "does not interact with" ;
    rdfs:comment "The subject drug does not have any pharmacological interaction with the substance or medication specified by the object entity." .

ns1:does_not_need_to_be_stopped_during a rdf:Property ;
    rdfs:label "does not need to be stopped during" ;
    rdfs:comment "The subject drug does not need to be discontinued during the event or condition specified by the object entity." .

ns1:dose_depends_on a rdf:Property ;
    rdfs:label "dose depends on" ;
    rdfs:comment "The subject drug's dose is determined by the factor specified by the object entity." .

ns1:fda_approval_year a rdf:Property ;
    rdfs:label "fda approval year" ;
    rdfs:comment "The subject drug was approved by the US FDA in the year specified by the object entity." .

ns1:had_all_cause_death_rate a rdf:Property ;
