ns1:include a rdf:Property ;
    rdfs:label "include" ;
    rdfs:comment "The subject entity comprises or contains the component or measurement specified by the object entity." .

ns1:increases_effect_of a rdf:Property ;
    rdfs:label "increases effect of" ;
    rdfs:comment "The subject drug enhances or potentiates the effect of the substance or condition specified by the object entity." .

ns1:increases_level_of a rdf:Property ;
    rdfs:label "increases level of" ;
    rdfs:comment "The subject drug increases the level of the substance or biomarker specified by the object entity in the body." .

ns1:increases_risk_of a rdf:Property ;
    rdfs:label "increases risk of" ;
    rdfs:comment "Taking the subject drug may raise the patient's likelihood of experiencing the condition or event specified by the object entity." .

ns1:interacts_with a rdf:Property ;
    rdfs:label "interacts with" ;
    rdfs:comment "The subject drug has a drug interaction with the drug or substance specified by the object entity that may change effects or cause harm." .

ns1:involves_buildup_of a rdf:Property ;
    rdfs:label "involves buildup of" ;
    rdfs:comment "The subject condition involves the accumulation of the substance specified by the object entity." .

ns1:is_a_man_made_form_of a rdf:Property ;
    rdfs:label "is a man made form of" ;
    rdfs:comment "The subject drug is a synthetic version of the substance specified by the object entity." .

ns1:is_a_type_of a rdf:Property ;
    rdfs:label "is a type of" ;
    rdfs:comment "The subject entity is a specific type or subtype of the object entity." .

ns1:is_available_by a rdf:Property ;
    rdfs:label "is available by" ;
    rdfs:comment "The subject product is available through the method or requirement specified by the object entity." .

ns1:is_salt_form_of a rdf:Property ;
    rdfs:label "is salt form of" ;
    rdfs:comment "The subject drug is a specific salt form of the active pharmaceutical ingredient specified by the object entity." .

ns1:lowers_level_of a rdf:Property ;
    rdfs:label "lowers level of" ;
    rdfs:comment "The subject drug decreases the level of the substance or biomarker specified by the object entity in the body." .

ns1:manufactured_by a rdf:Property ;
    rdfs:label "manufactured by" ;
    rdfs:comment "The subject drug is manufactured or marketed by the company specified by the object entity." .

ns1:manufacturer_location a rdf:Property ;
    rdfs:label "manufacturer location" ;
    rdfs:comment "The company that manufactures the subject drug is located in the geographic location specified by the object entity." .

ns1:may_affect a rdf:Property ;
    rdfs:label "may affect" ;
    rdfs:comment "The subject entity may influence the action, effectiveness, or safety of the object entity." .

ns1:may_be_confused_with a rdf:Property ;
    rdfs:label "may be confused with" ;
    rdfs:comment "The subject condition or symptom may be mistaken for the condition or symptom specified by the object entity." .

ns1:may_be_used_for a rdf:Property ;
    rdfs:label "may be used for" ;
    rdfs:comment "The subject drug can be used for the purpose or indication specified by the object entity." .

ns1:may_cause a rdf:Property ;
    rdfs:label "may cause" ;
    rdfs:comment "The subject action or condition can lead to or contribute to the development of the medical condition or effect specified by the object entity." .

ns1:may_cost a rdf:Property ;
    rdfs:label "may cost" ;
    rdfs:comment "The subject drug may have a specific cost or price, as specified by the object entity." .

ns1:may_have_added a rdf:Property ;
    rdfs:label "may have added" ;
    rdfs:comment "The subject drug may include the substance specified by the object entity to adjust or maintain its pH." .

ns1:may_have_different a rdf:Property ;
    rdfs:label "may have different" ;
    rdfs:comment "The subject drug formulation may differ from the object entity in the specified aspect." .

ns1:metabolism a rdf:Property ;
    rdfs:label "metabolism" ;
    rdfs:comment "The subject drug is metabolized in the body in the manner specified by the object entity." .

ns1:not_a a rdf:Property ;
    rdfs:label "not a" ;
    rdfs:comment "The subject drug is not classified as or does not belong to the category specified by the object entity." .

ns1:not_approved_for a rdf:Property ;
    rdfs:label "not approved for" ;
    rdfs:comment "The subject drug is not approved or not recommended for use in the patient population specified by the object entity." .

ns1:not_chemically_related_to a rdf:Property ;
    rdfs:label "not chemically related to" ;
    rdfs:comment "The subject drug does not share a chemical structure or mechanism of action with the substance specified by the object entity." .

ns1:not_eligible_for_savings_card_in a rdf:Property ;
    rdfs:label "not eligible for savings card in" ;
    rdfs:comment "Patients with the specified insurance type are not eligible for the savings card associated with the subject drug." .

ns1:not_used_for a rdf:Property ;
    rdfs:label "not used for" ;
    rdfs:comment "The subject drug is not indicated or used to treat the condition or situation specified by the object entity." .

ns1:occurs_in a rdf:Property ;
    rdfs:label "occurs in" ;
    rdfs:comment "The medical condition specified by the subject entity is associated with or found in the group of individuals described by the object entity." .

ns1:passes_into a rdf:Property ;
    rdfs:label "passes into" ;
    rdfs:comment "The subject drug is transferred or present in the substance or medium specified by the object entity." .

ns1:passes_into_breast_milk a rdf:Property ;
    rdfs:label "passes into breast milk" ;
    rdfs:comment "The subject drug is able to pass into breast milk in the quantity specified by the object entity." .

ns1:reduced_absorption_by a rdf:Property ;
    rdfs:label "reduced absorption by" ;
    rdfs:comment "The object entity reduces the amount of the subject drug that is absorbed into the bloodstream." .

ns1:reduces_response_to a rdf:Property ;
    rdfs:label "reduces response to" ;
    rdfs:comment "The subject drug may decrease the effectiveness or response to the object entity." .

ns1:reduces_risk_of a rdf:Property ;
    rdfs:label "reduces risk of" ;
    rdfs:comment "The subject drug is used to prevent or lower the risk of the medical event or condition specified by the object entity." .

ns1:remain_on a rdf:Property ;
    rdfs:label "remain on" ;
    rdfs:comment "The subject products continue to be available or present in the context specified by the object entity." .

ns1:requires_adjustment_of a rdf:Property ;
    rdfs:label "requires adjustment of" ;
    rdfs:comment "The subject drug necessitates changes or modifications to the treatment or dosage specified by the object entity." .

ns1:requires_monitoring_of a rdf:Property ;
    rdfs:label "requires monitoring of" ;
    rdfs:comment "Patients taking the subject drug may need the medical test or monitoring specified by the object entity." .

ns1:requires_washout_period a rdf:Property ;
    rdfs:label "requires washout period" ;
    rdfs:comment "The subject drug necessitates a specific period of time specified by the object entity before switching to another medication to avoid adverse interactions." .

ns1:risk_factors_include a rdf:Property ;
    rdfs:label "risk factors include" ;
    rdfs:comment "The subject condition or event has risk factors that include the object entity." .

ns1:should_be_avoided_with a rdf:Property ;
    rdfs:label "should be avoided with" ;
    rdfs:comment "Patients taking the subject drug should avoid the substance or activity specified by the object entity." .

ns1:should_inform_doctor_about a rdf:Property ;
    rdfs:label "should inform doctor about" ;
    rdfs:comment "Patients taking the subject drug should tell their doctor about the condition or circumstance specified by the object entity." .

ns1:should_not_be_stored_in a rdf:Property ;
    rdfs:label "should not be stored in" ;
    rdfs:comment "The subject drug should not be stored in the specified location." .

ns1:should_not_be_used_in_place_of a rdf:Property ;
    rdfs:label "should not be used in place of" ;
    rdfs:comment "The subject drug should not replace or substitute the treatment specified by the object entity." .

ns1:similar_to a rdf:Property ;
    rdfs:label "similar to" ;
    rdfs:comment "The subject drug is related to or an alternative for the drug specified by the object entity." .

ns1:slows a rdf:Property ;
    rdfs:label "slows" ;
    rdfs:comment "The subject drug reduces the rate or efficiency of the process specified by the object entity." .

ns1:switched_to a rdf:Property ;
    rdfs:label "switched to" ;
    rdfs:comment "The subject drug is replaced or transitioned to the drug specified by the object entity." .

ns1:treats a rdf:Property ;
    rdfs:label "treats" ;
    rdfs:comment "The subject drug is used to treat or manage the disease or medical condition specified by the object entity." .

ns1:use_with_caution_in a rdf:Property ;
    rdfs:label "use with caution in" ;
    rdfs:comment "The subject drug may be unsafe or require medical supervision for patients who have the condition or characteristic specified by the object entity." .

ns1:used_after a rdf:Property ;
    rdfs:label "used after" ;
    rdfs:comment "The subject drug is typically used following the medical event or condition specified by the object entity." .

ns1:used_in a rdf:Property ;
    rdfs:label "used in" ;
    rdfs:comment "The subject drug is utilized in the medical procedure or clinical context specified by the object entity." .

ns1:used_in_combination_with a rdf:Property ;
    rdfs:label "used in combination with" ;
    rdfs:comment "The subject drug is used together with the other treatment or lifestyle measure specified by the object entity." .

ns1:used_in_population a rdf:Property ;
    rdfs:label "used in population" ;
    rdfs:comment "The subject drug is used in or approved for the patient population or age group specified by the object entity." .

ns1:used_in_study a rdf:Property ;
    rdfs:label "used in study" ;
    rdfs:comment "The subject entity is used or tested in the study specified by the object entity." .

ns1:was_first_approved a rdf:Property ;
    rdfs:label "was first approved" ;
    rdfs:comment "The subject drug was initially approved for the indication or use specified by the object entity." .

ns1:was_withdrawn_from_market_in a rdf:Property ;
    rdfs:label "was withdrawn from market in" ;
    rdfs:comment "The subject drug was removed from sale or distribution in the country or region specified by the object entity." .

